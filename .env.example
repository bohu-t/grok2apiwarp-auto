GROK_STACK_CONSOLE_PORT=18600
GROK2API_HOST_PORT=8000
WARP_HOST=0.0.0.0
WARP_HOST_PORT=1080
# grok2api v3 配置
# 首次部署: 编辑 runtime/grok2api/config.yaml 修改 admin 密码和密钥
#           然后执行 ./scripts/gen-config.sh 自动填充密钥
GROK_REGISTER_DEFAULT_RUN_COUNT=50
GROK_REGISTER_DEFAULT_PROXY=socks5://warp:1080
GROK_REGISTER_DEFAULT_BROWSER_PROXY=socks5://warp:1080
GROK_REGISTER_DEFAULT_API_ENDPOINT=http://grok2api:8000/api/admin/v1/accounts/import
GROK_REGISTER_DEFAULT_API_TOKEN=change-this-admin-password
GROK_REGISTER_DEFAULT_API_APPEND=true
